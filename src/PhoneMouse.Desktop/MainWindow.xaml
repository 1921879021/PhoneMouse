<Window x:Class="PhoneMouse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Mouse"
        Width="640"
        Height="920"
        MinWidth="600"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border
            Grid.Row="0"
            Background="White"
            BorderBrush="#E9E9E9"
            BorderThickness="0,0,0,1">

            <Grid Margin="28,22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock
                        Text="Phone Mouse"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="#202124"/>

                    <TextBlock
                        Text="控制体验设置 · Alpha 0.7.2"
                        Margin="0,6,0,0"
                        FontSize="13"
                        Foreground="#80868B"/>

                </StackPanel>


                <Border
                    Grid.Column="1"
                    Padding="12,7"
                    CornerRadius="16"
                    Background="#E9F7EF"
                    VerticalAlignment="Center">

                    <TextBlock
                        x:Name="ServerStatusText"
                        Text="● 正在启动"
                        FontSize="13"
                        Foreground="#188038"/>

                </Border>

            </Grid>

        </Border>


        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="28">


                <!-- 新增设备 -->

                <Border
                    Background="White"
                    CornerRadius="14"
                    Padding="22"
                    BorderBrush="#ECECEC"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            Text="新增设备"
                            FontSize="14"
                            Foreground="#777777"/>


                        <TextBlock
                            x:Name="PhoneUrlText"
                            Margin="0,10,0,0"
                            Text="正在检测局域网地址..."
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#202124"
                            TextWrapping="Wrap"/>


                        <Border
                            Margin="0,18,0,0"
                            Padding="12"
                            HorizontalAlignment="Center"
                            CornerRadius="12"
                            Background="White"
                            BorderBrush="#ECECEC"
                            BorderThickness="1">

                            <Image
                                x:Name="QrCodeImage"
                                Width="190"
                                Height="190"
                                Stretch="Uniform"
                                SnapsToDevicePixels="True"/>

                        </Border>


                        <TextBlock
                            x:Name="PairingHintText"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Text="扫描一次性二维码授权新设备"
                            FontSize="13"
                            Foreground="#777777"/>


                        <Grid Margin="0,18,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Button
                                x:Name="CopyUrlButton"
                                Grid.Column="0"
                                Content="复制普通访问地址"
                                Height="40"
                                Click="CopyUrlButton_Click"/>


                            <Button
                                x:Name="RefreshQrButton"
                                Grid.Column="2"
                                Content="刷新配对二维码"
                                Height="40"
                                Click="RefreshQrButton_Click"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- 控制体验 -->

                <Border
                    Margin="0,16,0,0"
                    Background="White"
                    CornerRadius="14"
                    Padding="22"
                    BorderBrush="#ECECEC"
                    BorderThickness="1">

                    <StackPanel>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="控制体验"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#202124"/>

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="修改后会立即同步到当前已连接手机，并自动保存。"
                                    FontSize="12"
                                    Foreground="#888888"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                x:Name="ResetControlSettingsButton"
                                Content="恢复默认"
                                Padding="14,7"
                                VerticalAlignment="Center"
                                Click="ResetControlSettingsButton_Click"/>

                        </Grid>


                        <!-- 鼠标灵敏度 -->

                        <Grid Margin="0,22,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="鼠标灵敏度"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="控制单指移动时，电脑鼠标移动的距离。"
                                    FontSize="12"
                                    Foreground="#888888"/>

                            </StackPanel>


                            <TextBlock
                                x:Name="MouseSensitivityValueText"
                                Grid.Column="1"
                                Text="1.0×"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <Slider
                            x:Name="MouseSensitivitySlider"
                            Margin="0,12,0,0"
                            Minimum="0.5"
                            Maximum="3.0"
                            Value="1.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="ControlSetting_ValueChanged"/>


                        <Grid Margin="0,5,0,0">

                            <TextBlock
                                Text="慢 0.5×"
                                FontSize="11"
                                Foreground="#999999"/>

                            <TextBlock
                                Text="快 3.0×"
                                FontSize="11"
                                Foreground="#999999"
                                HorizontalAlignment="Right"/>

                        </Grid>


                        <!-- 滚轮速度 -->

                        <Grid Margin="0,24,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="滚轮速度"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="控制双指上下滑动时的滚动速度。"
                                    FontSize="12"
                                    Foreground="#888888"/>

                            </StackPanel>


                            <TextBlock
                                x:Name="ScrollSpeedValueText"
                                Grid.Column="1"
                                Text="1.0×"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <Slider
                            x:Name="ScrollSpeedSlider"
                            Margin="0,12,0,0"
                            Minimum="0.5"
                            Maximum="3.0"
                            Value="1.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="ControlSetting_ValueChanged"/>


                        <!-- 自然滚动 -->

                        <Grid Margin="0,24,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="自然滚动"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="开启后，双指滚动方向会与当前默认方向相反。"
                                    FontSize="12"
                                    Foreground="#888888"/>

                            </StackPanel>


                            <CheckBox
                                x:Name="NaturalScrollingCheckBox"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Checked="NaturalScrollingCheckBox_Changed"
                                Unchecked="NaturalScrollingCheckBox_Changed"/>

                        </Grid>


                        <!-- 长按时间 -->

                        <Grid Margin="0,24,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="拖拽长按时间"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="单指保持多久后进入左键拖拽。"
                                    FontSize="12"
                                    Foreground="#888888"/>

                            </StackPanel>


                            <TextBlock
                                x:Name="LongPressValueText"
                                Grid.Column="1"
                                Text="420 ms"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <Slider
                            x:Name="LongPressSlider"
                            Margin="0,12,0,0"
                            Minimum="250"
                            Maximum="900"
                            Value="420"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            ValueChanged="ControlSetting_ValueChanged"/>


                        <Grid Margin="0,5,0,0">

                            <TextBlock
                                Text="更快 250 ms"
                                FontSize="11"
                                Foreground="#999999"/>

                            <TextBlock
                                Text="更稳 900 ms"
                                FontSize="11"
                                Foreground="#999999"
                                HorizontalAlignment="Right"/>

                        </Grid>


                        <!-- 微信发送快捷键 -->

                        <Grid Margin="0,24,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="微信发送快捷键"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Margin="0,4,16,0"
                                    Text="“微信安全发送”会先确认当前前台窗口确实是微信，再使用这里选择的快捷键。"
                                    FontSize="12"
                                    Foreground="#888888"
                                    TextWrapping="Wrap"/>

                            </StackPanel>


                            <ComboBox
                                x:Name="WeChatSendModeComboBox"
                                Grid.Column="1"
                                Height="36"
                                VerticalAlignment="Center"
                                SelectedIndex="0"
                                SelectionChanged="WeChatSendModeComboBox_SelectionChanged">

                                <ComboBoxItem Content="Enter 发送"/>

                                <ComboBoxItem Content="Ctrl + Enter 发送"/>

                            </ComboBox>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- 状态 -->

                <Border
                    Margin="0,16,0,0"
                    Background="White"
                    CornerRadius="14"
                    Padding="22"
                    BorderBrush="#ECECEC"
                    BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="服务端口"
                            Foreground="#777777"/>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="9527"
                            FontWeight="SemiBold"/>


                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,16,0,0"
                            Text="已认证在线设备"
                            Foreground="#777777"/>

                        <TextBlock
                            x:Name="ConnectedClientsText"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,16,0,0"
                            Text="0"
                            FontWeight="SemiBold"/>


                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,16,0,0"
                            Text="已配对设备"
                            Foreground="#777777"/>

                        <TextBlock
                            x:Name="TrustedDevicesText"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,16,0,0"
                            Text="0"
                            FontWeight="SemiBold"/>

                    </Grid>

                </Border>


                <!-- 设备管理 -->

                <Border
                    Margin="0,16,0,0"
                    Background="White"
                    CornerRadius="14"
                    Padding="22"
                    BorderBrush="#ECECEC"
                    BorderThickness="1">

                    <StackPanel>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="已配对设备"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#202124"/>

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="移除设备后，该设备的控制权限立即失效。"
                                    FontSize="12"
                                    Foreground="#888888"/>

                            </StackPanel>


                            <Button
                                x:Name="RemoveAllDevicesButton"
                                Grid.Column="1"
                                Padding="14,7"
                                Content="全部解除配对"
                                VerticalAlignment="Center"
                                Click="RemoveAllDevicesButton_Click"/>

                        </Grid>


                        <Border
                            Margin="0,16,0,0"
                            BorderBrush="#EEEEEE"
                            BorderThickness="0,1,0,0"/>


                        <TextBlock
                            x:Name="NoDevicesText"
                            Margin="0,20,0,4"
                            Text="暂无已配对设备"
                            HorizontalAlignment="Center"
                            Foreground="#999999"
                            Visibility="Collapsed"/>


                        <StackPanel
                            x:Name="TrustedDevicesPanel"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>


                <TextBlock
                    Margin="4,20,4,24"
                    Text="控制设置保存在当前 Windows 用户的本地配置中。当前仍使用 HTTP / ws://，仅建议在可信任的家庭 Wi-Fi 或个人热点中使用。"
                    Foreground="#888888"
                    FontSize="12"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>
